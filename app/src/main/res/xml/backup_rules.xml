<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6~11（API 23~30）的自动备份规则，也就是 `android:fullBackupContent` 指向的文件。
  API 31+ 走 data_extraction_rules.xml。**两个文件的排除清单必须保持一致**，
  否则同一份数据在老机器上不进备份、在新机器上进（或者反过来），排查时会对不上现象。

  ⚠ 这个文件同时也管 `adb backup`。插上 USB 就能把 App 数据拉走的年代已经过去了
  （Android 12 起 `adb backup` 默认只拉 manifest），但 API 30 的设备上它仍然有效，
  所以凭据必须显式排除。

  排除项与理由的完整版写在 data_extraction_rules.xml 里，这里只复述结论：
  凭据（`datastore/`）、订单镜像（`mirror*/`）、变更日志（`logs/`）一律不备份；
  Room 数据库（`databases/`）**要**备份，那是用户手录的商品资产。
-->
<full-backup-content>

    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="mirror/" />
    <exclude domain="file" path="mirror-tmp/" />
    <exclude domain="file" path="mirror-quarantine/" />
    <exclude domain="file" path="mirror-archive/" />
    <exclude domain="file" path="logs/" />

</full-backup-content>
